// Tüm yapılandırmalarda ortak ayarlar.
// Team ID repoya girmez: Config/Local.xcconfig (gitignore'lu) ya da CI'da
// TEAM_ID ortam değişkeni sağlar. Dosya yoksa include sessizce atlanır.
#include? "Local.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.sessizdefter.app
PRODUCT_NAME = $(TARGET_NAME)

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 3

// Local.xcconfig ya da CI TEAM_ID tanımlamazsa boş kalır; boş takım kimliğiyle
// yalnızca imzasız simülatör derlemesi yapılabilir.
DEVELOPMENT_TEAM = $(TEAM_ID)
CODE_SIGN_STYLE = Automatic

IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0

INFOPLIST_FILE = App/Info.plist
INFOPLIST_KEY_UILaunchScreen_Generation = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
SWIFT_EMIT_LOC_STRINGS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
